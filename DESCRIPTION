Package: PDRobust
Title: Robust Longitudinal Effects Under Truncation by Death
Version: 0.3.8
Authors@R: c(
    person(
        given = "Huan",
        family = "Wang",
        email = "whhuan42@gmail.com",
        role = c("aut", "cre")
