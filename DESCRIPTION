Package: PDRobust
Title: Robust Longitudinal Treatment Effect Estimation Under Truncation by Death
Version: 0.3.7
Authors@R: c(
    person(
        given = "Huan",
        family = "Wang",
        email = "whhuan42@gmail.com",
        role = c("aut", "cre")
